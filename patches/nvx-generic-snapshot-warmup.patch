--- a/scripts/nvx_tools/build.py
+++ b/scripts/nvx_tools/build.py
@@ -4,0 +5 @@ from __future__ import annotations
+import hashlib
@@ -7,0 +9 @@ import subprocess
+import zipfile
@@ -66,0 +69 @@ class PythonInitramfsProfile:
+    wheels: tuple[tuple[str, str], ...]
@@ -77 +80,7 @@ PYTHON_INITRAMFS_PROFILES = {
-        packages=("python3", "py3-numpy", "py3-pandas"),
+        packages=("python3", "py3-numpy", "py3-pandas", "pandoc"),
+        wheels=(
+            (
+                "pypandoc-1.17-py3-none-any.whl",
+                "01fdbffa61edb9f8e82e8faad6954efcb7b6f8f0634aead4d89e322a00225a67",
+            ),
+        ),
@@ -96,0 +106 @@ PYTHON_INITRAMFS_PROFILES = {
+        wheels=(),
@@ -325,0 +336,24 @@ def _normalize_initramfs_metadata(root: Path) -> None:
+def _install_python_wheel(root: Path, name: str, expected_sha256: str) -> None:
+    wheel = REPO_ROOT / "alpine" / name
+    if not wheel.is_file():
+        raise ScriptError(f"required Python wheel does not exist: {wheel}")
+    actual_sha256 = hashlib.sha256(wheel.read_bytes()).hexdigest()
+    if actual_sha256 != expected_sha256:
+        raise ScriptError(
+            f"unexpected SHA-256 for {wheel}: {actual_sha256}"
+        )
+    site_packages = tuple((root / "usr" / "lib").glob("python3.*/site-packages"))
+    if len(site_packages) != 1:
+        raise ScriptError(
+            f"expected one Python site-packages directory, found {len(site_packages)}"
+        )
+    with zipfile.ZipFile(wheel) as archive:
+        if any(
+            Path(member.filename).is_absolute()
+            or ".." in Path(member.filename).parts
+            for member in archive.infolist()
+        ):
+            raise ScriptError(f"Python wheel contains an unsafe path: {wheel}")
+        archive.extractall(site_packages[0])
+
+
@@ -407,0 +442,2 @@ def build_python_initramfs_native(
+    for wheel_name, wheel_sha256 in profile.wheels:
+        _install_python_wheel(root, wheel_name, wheel_sha256)
