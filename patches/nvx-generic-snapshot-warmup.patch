--- a/alpine/snapshot-trampoline.py
+++ b/alpine/snapshot-trampoline.py
@@ -9 +8,0 @@ Optional warmup is explicit so baseline benchmarks can measure an untrained inte
-import ctypes
@@ -11,0 +11 @@ import runpy
+import subprocess
@@ -12,0 +13,2 @@ import sys
+import time
+import traceback
@@ -14,0 +17,2 @@ USAGE = "usage: snapshot-trampoline.py [--mount TAG DIR MODE] [--warmup] APP"
+BENCHMARK_ITERATIONS_FILE = ".vmm-benchmark-iterations"
+EXIT_PORT = 0x604
@@ -16 +19,0 @@ SNAPSHOT_PORT = 0x605
-MS_RDONLY = 1
@@ -48,0 +52 @@ def warm_interpreter() -> None:
+    import pypandoc
@@ -51,0 +56 @@ def warm_interpreter() -> None:
+    assert pypandoc.__version__ == "1.17"
@@ -54 +59 @@ def warm_interpreter() -> None:
-def request_snapshot() -> None:
+def write_port(port: int, value: int) -> None:
@@ -56,2 +61,10 @@ def request_snapshot() -> None:
-        device.seek(SNAPSHOT_PORT)
-        device.write(b"\x01")
+        device.seek(port)
+        device.write(bytes([value & 0xFF]))
+
+
+def request_snapshot() -> None:
+    write_port(SNAPSHOT_PORT, 1)
+
+
+def request_exit(status: int) -> None:
+    write_port(EXIT_PORT, status)
@@ -64,15 +77,88 @@ def mount_hostfs(tag: str, directory: str, mode: str) -> None:
-    libc = ctypes.CDLL(None, use_errno=True)
-    mount = libc.mount
-    mount.argtypes = [
-        ctypes.c_char_p,
-        ctypes.c_char_p,
-        ctypes.c_char_p,
-        ctypes.c_ulong,
-        ctypes.c_void_p,
-    ]
-    mount.restype = ctypes.c_int
-    flags = MS_RDONLY if mode == "ro" else 0
-    if mount(tag.encode(), directory.encode(), b"virtiofs", flags, None) != 0:
-        error = ctypes.get_errno()
-        raise SystemExit(
-            f"virtfs: failed to mount tag {tag} at {directory}: {os.strerror(error)}"
+    completed = subprocess.run(
+        ["mount", "-t", "virtiofs", "-o", mode, tag, directory],
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise SystemExit(f"virtfs: failed to mount tag {tag} at {directory}")
+
+
+def benchmark_iterations(app: str) -> int | None:
+    control = os.path.join(os.path.dirname(app), BENCHMARK_ITERATIONS_FILE)
+    try:
+        with open(control, encoding="ascii") as source:
+            value = int(source.read().strip())
+    except FileNotFoundError:
+        return None
+    except ValueError as error:
+        raise SystemExit(f"invalid benchmark iteration count in {control}") from error
+    if value <= 0:
+        raise SystemExit(f"benchmark iteration count must be positive: {value}")
+    return value
+
+
+def system_exit_code(error: SystemExit) -> int:
+    if error.code is None:
+        return 0
+    if isinstance(error.code, int):
+        return error.code & 0xFF
+    print(error.code, file=sys.stderr)
+    return 1
+
+
+def wait_for_child(child: int) -> int:
+    while True:
+        try:
+            return os.waitpid(child, 0)[1]
+        except InterruptedError:
+            continue
+
+
+def run_isolated(app: str) -> tuple[int, float, float]:
+    sys.stdout.flush()
+    sys.stderr.flush()
+    timing_reader, timing_writer = os.pipe()
+    cycle_started = time.perf_counter_ns()
+    child = os.fork()
+    if child == 0:
+        os.close(timing_reader)
+        status = 0
+        call_started = time.perf_counter_ns()
+        try:
+            runpy.run_path(app, run_name="__main__")
+        except SystemExit as error:
+            status = system_exit_code(error)
+        except BaseException:
+            traceback.print_exc()
+            status = 1
+        call_ns = time.perf_counter_ns() - call_started
+        sys.stdout.flush()
+        sys.stderr.flush()
+        os.write(timing_writer, str(call_ns).encode("ascii"))
+        os.close(timing_writer)
+        os._exit(status)
+
+    os.close(timing_writer)
+    chunks = []
+    while chunk := os.read(timing_reader, 64):
+        chunks.append(chunk)
+    os.close(timing_reader)
+    wait_status = wait_for_child(child)
+    cycle_ns = time.perf_counter_ns() - cycle_started
+    timing = b"".join(chunks)
+    call_ns = int(timing) if timing else cycle_ns
+    if os.WIFEXITED(wait_status):
+        status = os.WEXITSTATUS(wait_status)
+    elif os.WIFSIGNALED(wait_status):
+        status = 128 + os.WTERMSIG(wait_status)
+    else:
+        status = 127
+    return status, call_ns / 1_000_000, max(0, cycle_ns - call_ns) / 1_000_000
+
+
+def run_benchmark(app: str, iterations: int) -> int:
+    for iteration in range(iterations):
+        status, call_ms, rewind_ms = run_isolated(app)
+        print(
+            f"BENCHMARK_PHASE warm_iteration={iteration} "
+            f"guest_call_ms={call_ms:.6f} rewind_ms={rewind_ms:.6f}",
+            flush=True,
@@ -79,0 +166,4 @@ def mount_hostfs(tag: str, directory: str, mode: str) -> None:
+        if status != 0:
+            return status
+    print("BENCHMARK_OK", flush=True)
+    return 0
@@ -85,0 +176 @@ def main(argv: list[str]) -> None:
+    exec(compile("pass", "<snapshot-warmup>", "exec"), {"__name__": "__main__"})
@@ -89 +180,7 @@ def main(argv: list[str]) -> None:
-    runpy.run_path(app, run_name="__main__")
+    iterations = benchmark_iterations(app)
+    if iterations is None:
+        runpy.run_path(app, run_name="__main__")
+        return
+    status = run_benchmark(app, iterations)
+    request_exit(status)
+    raise SystemExit(status)
